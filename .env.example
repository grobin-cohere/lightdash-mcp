# Your Lightdash instance.
LIGHTDASH_URL=http://localhost:8080

# Required. The OAuth client this server signs users in with: register it as in docs/configuration.md.
LIGHTDASH_CLIENT_ID=
LIGHTDASH_CLIENT_SECRET=

# Required. Encrypts what is stored in Redis. Generate one with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Where sign-ins and tokens are kept. With a password: redis://:<password>@127.0.0.1:6380/0
REDIS_URL=redis://localhost:6379/0

# The address clients reach this server at: https, unless it is localhost. Defaults to http://localhost:<PORT>.
# PUBLIC_URL=https://lightdash-mcp.example.ts.net

# Listen on 127.0.0.1 when the HTTPS proxy runs on this machine, also in Docker with network_mode host.
# HOST=127.0.0.1
# PORT=8000

# Seconds an access token issued to MCP clients lasts, from 60 to 1209600 (14 days). Defaults to 3600.
# Raise it for clients that never refresh their token, such as Dex's OAuth connector.
# ACCESS_TOKEN_TTL=3600

# Comma-separated. When set, clients can register https redirect URIs on these hosts only.
# REDIRECT_HOSTS=dex.example.com
